export PATH="$HOME/.local/bin:$PATH"
export ZENITH_STATE_DIR="$HOME/.config/zenith/state"
mkdir -p "$ZENITH_STATE_DIR"

if command -v ollama >/dev/null 2>&1 && ! ollama list >/dev/null 2>&1; then
  __ZENITH_OLLAMA_PID_FILE="$ZENITH_STATE_DIR/ollama.pid"
  if [ ! -f "$__ZENITH_OLLAMA_PID_FILE" ] || ! kill -0 "$(cat "$__ZENITH_OLLAMA_PID_FILE" 2>/dev/null)" 2>/dev/null; then
    mkdir -p "$HOME/.config/zenith/logs"
    nohup ollama serve >> "$HOME/.config/zenith/logs/ollama.log" 2>&1 &
    printf '%s\n' "$!" > "$__ZENITH_OLLAMA_PID_FILE"
    sleep 1
  fi
fi

if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi

if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
fi

if command -v zen >/dev/null 2>&1; then
  zen upgrade surface --startup-check 2>/dev/null || true
fi

if [[ -o interactive ]] && [[ -z "${__ZENITH_CAPTURE_INSTALLED:-}" ]]; then
  typeset -g __ZENITH_CAPTURE_INSTALLED=1
  typeset -g __ZENITH_SESSION_STDERR="$ZENITH_STATE_DIR/session.stderr"
  touch "$__ZENITH_SESSION_STDERR"
  exec 2> >(tee -a "$__ZENITH_SESSION_STDERR" >&2)

  __zenith_preexec() {
    emulate -L zsh
    local cmd="$1"
    case "$cmd" in
      __zenith_*|history*|fc* )
        return
        ;;
    esac
    print -r -- "$PWD" > "$ZENITH_STATE_DIR/last_pwd"
    print -r -- "$cmd" > "$ZENITH_STATE_DIR/last_command"
    : > "$ZENITH_STATE_DIR/last_stderr"
    typeset -g __ZENITH_ERR_OFFSET
    __ZENITH_ERR_OFFSET=$(wc -c < "$__ZENITH_SESSION_STDERR")
  }

  __zenith_precmd() {
    emulate -L zsh
    local exit_status=$?
    local start_offset="${__ZENITH_ERR_OFFSET:-0}"
    local end_offset=0
    print -r -- "$exit_status" > "$ZENITH_STATE_DIR/last_status"
    if [ -f "$__ZENITH_SESSION_STDERR" ]; then
      end_offset=$(wc -c < "$__ZENITH_SESSION_STDERR")
    fi
    if [ "$end_offset" -gt "$start_offset" ]; then
      tail -c +$((start_offset + 1)) "$__ZENITH_SESSION_STDERR" > "$ZENITH_STATE_DIR/last_stderr" || true
    else
      : > "$ZENITH_STATE_DIR/last_stderr"
    fi
  }

  autoload -Uz add-zsh-hook
  add-zsh-hook preexec __zenith_preexec
  add-zsh-hook precmd __zenith_precmd
fi

alias zenith="zen"
alias dash="zen workspace"
